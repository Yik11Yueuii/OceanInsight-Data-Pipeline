{
  "job": {
    "setting": {"speed": {"channel": 1}, "errorLimit": {"record": 0}},
    "content": [{
      "reader": {
        "name": "txtfilereader",
        "parameter": {
          "path": ["${INPUT_PATH}"], "encoding": "UTF-8", "skipHeader": true,
          "fieldDelimiter": ",", "column": ["*"]
        }
      },
      "writer": {
        "name": "hdfswriter",
        "parameter": {
          "defaultFS": "${HDFS_DEFAULT_FS}", "fileType": "text",
          "path": "${HDFS_OUTPUT_PATH}", "fileName": "part",
          "writeMode": "append", "fieldDelimiter": ",", "column": ["*"]
        }
      }
    }]
  }
}

